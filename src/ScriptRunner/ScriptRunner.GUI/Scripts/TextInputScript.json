{
  "$schema": "../../../../schema/v1/ScriptRunnerSchema.json",
  "actions": [
    {
      "name": "Ping",
      "description": "Execute ping command",
      "command": "ping {address} -t",
      "params": [
        {
          "name": "address",
          "prompt": "text",
          "default": "www.wp.pl"
        }
      ],
      "predefinedArgumentSets": [
        {
          "description": "Ping Twitter",
          "arguments": {
            "address": "wwww.twitter.com"
          }
        },
        {
          "description": "Ping Github",
          "arguments": {
            "address": "wwww.github.com"
          }
        }
      ]
    },
    {
      "name": "Test Bindings",
      "command": "pwsh.exe -NoProfile -Command Write-Host \"{user} {password}\"",
      "params": [
        {
          "name": "user",
          "prompt": "text"
        },
        {
          "name": "password",
          "prompt": "password"
        }
      ],
      "predefinedArgumentSets": [
        {
          "description": "First user set",
          "arguments": {
            "user": "User 1"
          }
        },
        {
          "description": "Second user set",
          "arguments": {
            "user": "User 2"
          }
        },
        {
          "description": "Third user set",
          "arguments": {
            "user": "User 2"
          }
        }
      ]
    },
    {
      "name": "FallbackToExisting Demo",
      "description": "Demonstrates the fallbackToExisting feature",
      "command": "echo Server: {server}, Port: {port}, Username: {username}",
      "params": [
        {
          "name": "server",
          "description": "Server address",
          "prompt": "text",
          "default": "localhost"
        },
        {
          "name": "port",
          "description": "Port number",
          "prompt": "text",
          "default": ""
        },
        {
          "name": "username",
          "description": "Username",
          "prompt": "text",
          "default": ""
        }
      ],
      "predefinedArgumentSets": [
        {
          "description": "Production Server Only",
          "fallbackToDefault": true,
          "fallbackToExisting": true,
          "arguments": {
            "server": "prod.example.com"
          }
        },
        {
          "description": "Dev Server (clears other fields)",
          "fallbackToDefault": true,
          "arguments": {
            "server": "dev.example.com"
          }
        },
        {
          "description": "Full Production Config",
          "fallbackToDefault": true,
          "arguments": {
            "server": "prod.example.com",
            "port": "443",
            "username": "admin"
          }
        }
      ]
    },
    {
      "name": "AllControlsTest",
      "description": "Demo of all available controls and parameter grouping features",
      "command": "pwsh.exe -NoProfile -Command Write-Host '{scheduledAt} {p1} {p2} {p3} {p4} {p5} {p6} {p7} {p8} {p9} {p10} {p11} {p12}'",
      "parameterGroups": [
        {
          "key": "date",
          "label": "Date and time",
          "description": "Date, time, and scheduling controls grouped using declared metadata."
        },
        {
          "key": "text",
          "label": "Text and editors",
          "description": "Single-line inputs and multiline editors with different syntax modes."
        },
        {
          "key": "files",
          "label": "Files and folders",
          "description": "Controls used to select files and directories."
        }
      ],
      "params": [
        {
          "name": "sampleDatePicker",
          "prompt": "datePicker",
          "group": "date",
          "promptSettings": {
            "todayAsDefault": "true"
          }
        },
        {
          "name": "scheduledAt",
          "prompt": "dateTimePicker",          
          "description": "Schedule date and time",
          "group": "date",
          "promptSettings": {
            "format": "yyyy-MM-dd HH:mm:ss",
            "todayAsDefault": "true"
          }
        },        
        {
          "name": "p1",
          "description": "Text parameter",
          "group": "text",
          "required": true,
          "prompt": "text"
        },
        {
          "name": "p2",
          "description": "Multiline Text parameter",
          "group": "text",
          "default": "Line 1\r\n Line 2",
          "prompt": "multilineText"
        },
        {
          "name": "p3",
          "description": "Multiline JSON",
          "group": "text",
          "default": "Line 1\r\n Line 2",
          "prompt": "multilineText",
          "promptSettings": {
            "syntax": "json"
          }
        },
        {
          "name": "p31",
          "description": "Multiline C# code",
          "group": "text",
          "default": "Line 1\r\n Line 2",
          "prompt": "multilineText",
          "promptSettings": {
            "syntax": "cs"
          }
        },
        {
          "name": "p32",
          "description": "SQL code",
          "required": true,
          "details": "This is a multiline sql code with sqlserver syntax\r\n but postgres might be supported as well",
          "group": "text",
          "default": "Line 1\r\n Line 2",
          "prompt": "multilineText",
          "promptSettings": {
            "syntax": "sql"
          }
        },
        {
          "name": "p4",
          "description": "File Content",
          "group": "text",
          "default": "using System;\r\n\r\nclass Program {\r\n    static void Main() {\r\n        Console.WriteLine(\"Hello, World!\");\r\n    }\r\n}",
          "prompt": "fileContent",
          "promptSettings": {
            "extension": "cs",
            "templateText": "using System;\r\n\r\nclass Program {\r\n    static void Main() {\r\n        Console.WriteLine(\"Hello, World!\");\r\n    }\r\n}"
          }
        },
        {
          "name": "p5",
          "description": "Checkbox parameter",
          "default": "checked",
          "prompt": "checkbox",
          "promptSettings":{
            "checkedValue": "checked",
            "uncheckedValue": "unchecked"
          }
        },
        {
          "name": "p6",
          "description": "Date parameter",
          "group": "date",
          "default": "2022-05-03",
          "prompt": "datePicker",
          "promptSettings":{
            "format":"yyyy-MM-dd"
          }
        },
        {
          "name": "p7",
          "description": "Year-Month parameter",
          "group": "date",
          "default": "2022-05",
          "prompt": "datePicker",
          "promptSettings":{
            "format":"yyyy-MM",
            "dayVisible":"false"
          }
        },
        {
          "name": "p8",
          "description": "Dropdown parameter",
          "default": "val3",
          "prompt": "dropdown",
          "promptSettings":{
            "options":"val1,val2,val3,val4"
          }
        },
        {
          "name": "p9",
          "description": "MultiSelect parameter",
          "default": "val3,val4",
          "prompt": "multiSelect",
          "promptSettings":{
            "options":"val1,val2,val3,val4",
            "delimiter":","
          }
        },
        {
          "name": "p10",
          "description": "Password parameter",
          "group": "security",
          "default": "secret",
          "prompt": "password"
        },
        {
          "name": "p11",
          "description": "File parameter",
          "group": "files",
          "default": "c:\\Windows\\explorer.exe",
          "prompt": "filePicker"
        },
        {
          "name": "p12",
          "description": "Directory parameter",
          "group": "files",
          "default": "c:\\Windows\\",
          "prompt": "directoryPicker"
        },
        {
          "name": "p14",
          "description": "Numeric parameter",
          "group": "advanced",
          "required": true,          
          "prompt": "numeric",
          "promptSettings": {
            "min": "5",
            "max": "15",
            "step": "2"
          }
        },
        {
          "name": "p15",
          "description": "Time parameter",
          "group": "advanced",
          "default": "07:30",
          "prompt": "timePicker",
          "promptSettings": {
            "format": "hh\\:mm"
          }
        }
      ]
    },
    {
      "name": "Test Timepicker",
      "command": "pwsh.exe -NoProfile -Command Write-Host \"{time1} {date1} {number}\"",
      "params": [
        {
          "name": "time1",
          "prompt": "timePicker",
          "default": "07:30",
          "required": true,
          "promptSettings": {
            "format": "hh\\:mm"
          }
        },
        {
          "name": "date1",
          "prompt": "dateTimePicker",
          "default": "2022-05-01 7:30",
          "required": true
        },
        {
          "name": "time2",
          "prompt": "timePicker",
          "default": "07:30",
          "required": true,
          "promptSettings": {
            "format": "hh\\:mm"
          }
        },
        {
          "name": "number",
          "prompt": "numeric",          
          "required": true
        }
      ]
    }
  ]
}
