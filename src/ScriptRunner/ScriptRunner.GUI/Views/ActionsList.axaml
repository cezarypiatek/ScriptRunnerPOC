<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:ScriptRunner.GUI.ViewModels"
             xmlns:views="clr-namespace:ScriptRunner.GUI.Views"
             xmlns:scriptConfigs="clr-namespace:ScriptRunner.GUI.ScriptConfigs"
             xmlns:documents="clr-namespace:Avalonia.Controls.Documents;assembly=Avalonia.Controls"
             xmlns:avalonia="https://github.com/projektanker/icons.avalonia"
             xmlns:converters="clr-namespace:ScriptRunner.GUI.Converters"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="viewModels:MainWindowViewModel"
             x:Class="ScriptRunner.GUI.Views.ActionsList">
    <UserControl.Resources>
        <converters:CategoryToColorConverter x:Key="CategoryToColorConverter"/>
    </UserControl.Resources>
    
    <UserControl.Styles>
        <!-- Styles for list view tiles -->
        <Style Selector="Border.actionTile">
            <Setter Property="Background" Value="#252525"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,0,0,0"/>
        </Style>
        
        <Style Selector="Border.actionTile:pointerover">
            <Setter Property="Background" Value="#2d2d2d"/>
            <Setter Property="BorderBrush" Value="#3baced"/>
            <Setter Property="BorderThickness" Value="3,0,0,0"/>
        </Style>
        
        <Style Selector="Border.actionTile.selected">
            <Setter Property="Background" Value="#2a4a5a"/>
            <Setter Property="BorderBrush" Value="#3baced"/>
            <Setter Property="BorderThickness" Value="3,0,0,0"/>
        </Style>
        
        <Style Selector="Border.actionTile.selected:pointerover">
            <Setter Property="Background" Value="#336a7f"/>
            <Setter Property="BorderBrush" Value="#3baced"/>
            <Setter Property="BorderThickness" Value="3,0,0,0"/>
        </Style>

        <Style Selector="ToggleButton.quickFilter">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="BorderBrush" Value="#3f3f46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style Selector="ToggleButton.quickFilter:checked">
            <Setter Property="Background" Value="#234A73"/>
            <Setter Property="BorderBrush" Value="#4A9EFF"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style Selector="Button.filterButton">
            <Setter Property="Background" Value="#252526"/>
            <Setter Property="BorderBrush" Value="#3f3f46"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style Selector="Button.filterButton.active">
            <Setter Property="Background" Value="#234A73"/>
            <Setter Property="BorderBrush" Value="#4A9EFF"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </UserControl.Styles>
    
    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <!-- Search Box -->
        <Border Grid.Row="0" Background="#1e1e1e" Padding="8,4" BorderBrush="#3f3f46" BorderThickness="0,0,0,1">
            <TextBox x:Name="SearchTextBox"
                     Text="{Binding ActionFilter}" 
                     Watermark="Search actions..."
                     BorderThickness="1"
                     BorderBrush="#3f3f46"
                     Background="#252526"
                     Padding="8,6,35,6">
                <TextBox.InnerLeftContent>
                    <avalonia:Icon Value="fa-search" FontSize="14" Foreground="#888888" Margin="8,0,0,0"/>
                </TextBox.InnerLeftContent>
                <TextBox.InnerRightContent>
                    <Button Classes="clearButton"
                            Width="24"
                            Height="24"
                            Padding="0"
                            Margin="0,0,4,0"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            IsVisible="{Binding ActionFilter, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                            Click="ClearSearch_Click">
                        <avalonia:Icon Value="fa-times-circle" FontSize="14" Foreground="#888888"/>
                    </Button>
                </TextBox.InnerRightContent>
            </TextBox>
        </Border>
        
        <!-- Compact quick filters; categories live in the Filters popover. -->
        <Border Grid.Row="1" Background="#1e1e1e" Padding="8,4" BorderBrush="#3f3f46" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                <ToggleButton Grid.Column="0"
                              Classes="quickFilter"
                              IsChecked="{Binding IsFavoritesFilterSelected, Mode=OneWay}"
                              Click="FavoritesFilter_Click"
                              ToolTip.Tip="Show favorite actions">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <avalonia:Icon Value="fas fa-star"
                                       Width="14"
                                       Height="14"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Foreground="#FFD166"/>
                        <TextBlock Text="Favorites" VerticalAlignment="Center"/>
                    </StackPanel>
                </ToggleButton>

                <ToggleButton Grid.Column="1"
                              Classes="quickFilter"
                              IsChecked="{Binding IsRecentFilterSelected, Mode=OneWay}"
                              Click="RecentFilter_Click"
                              ToolTip.Tip="Show recently executed actions">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <avalonia:Icon Value="fas fa-clock"
                                       Width="14"
                                       Height="14"
                                       FontSize="12"
                                       VerticalAlignment="Center"/>
                        <TextBlock Text="Recent" VerticalAlignment="Center"/>
                    </StackPanel>
                </ToggleButton>

                <Button Grid.Column="2"
                        x:Name="FiltersButton"
                        Classes="filterButton"
                        Classes.active="{Binding IsCategoryFilterSelected}"
                        ToolTip.Tip="Filter actions by category">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <avalonia:Icon Value="fas fa-filter"
                                       Width="14"
                                       Height="14"
                                       FontSize="12"
                                       VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CategoryFilterButtonText}"
                                   VerticalAlignment="Center"
                                   MaxWidth="90"
                                   TextTrimming="CharacterEllipsis"/>
                        <avalonia:Icon Value="fas fa-chevron-down"
                                       Width="12"
                                       Height="12"
                                       FontSize="9"
                                       VerticalAlignment="Center"
                                       Opacity="0.7"/>
                    </StackPanel>
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedLeft">
                            <Border Background="#252526"
                                    BorderBrush="#48484E"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="6"
                                    MinWidth="220"
                                    MaxWidth="300">
                                <Grid RowDefinitions="Auto,*">
                                    <TextBlock Text="Categories"
                                               Margin="8,5,8,8"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="#A0A0A0"/>
                                    <ScrollViewer Grid.Row="1" MaxHeight="340" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding AvailableCategories}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="viewModels:CategoryFilterOption">
                                                    <Border Padding="8,7"
                                                            Margin="0,1"
                                                            CornerRadius="4"
                                                            Cursor="Hand"
                                                            IsVisible="{Binding !IsFavorite}"
                                                            Classes="categoryFilterOption"
                                                            Classes.selected="{Binding IsSelected}"
                                                            Tapped="CategoryBadge_OnTapped">
                                                        <Border.Styles>
                                                            <Style Selector="Border.categoryFilterOption">
                                                                <Setter Property="Background" Value="Transparent"/>
                                                            </Style>
                                                            <Style Selector="Border.categoryFilterOption:pointerover">
                                                                <Setter Property="Background" Value="#303035"/>
                                                            </Style>
                                                            <Style Selector="Border.categoryFilterOption.selected">
                                                                <Setter Property="Background" Value="#234A73"/>
                                                            </Style>
                                                        </Border.Styles>
                                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                                            <Border Width="9"
                                                                    Height="9"
                                                                    CornerRadius="5"
                                                                    Margin="0,0,9,0"
                                                                    VerticalAlignment="Center"
                                                                    Background="{Binding Key, Converter={StaticResource CategoryToColorConverter}}"/>
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding DisplayName}"
                                                                       FontSize="12"
                                                                       VerticalAlignment="Center"/>
                                                            <avalonia:Icon Grid.Column="2"
                                                                           Value="fas fa-check"
                                                                           Width="10"
                                                                           Height="10"
                                                                           Margin="12,0,0,0"
                                                                           Foreground="#4A9EFF"
                                                                           IsVisible="{Binding IsSelected}"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </Grid>
        </Border>
        
        <!-- Content Area: List View -->
        <Panel Grid.Row="2">
            <!-- List View with Tiles -->
            <ScrollViewer Background="#1e1e1e"
                          VerticalScrollBarVisibility="Auto"
                          IsVisible="{Binding !IsRecentFilterSelected}">
                <ItemsControl ItemsSource="{Binding FilteredActionList}" Margin="4">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:TaggedScriptConfig">
                            <Border CornerRadius="4"
                                    Padding="12,8"
                                    Margin="4,2"
                                    Cursor="Hand"
                                    Classes="actionTile"
                                    Tapped="ActionTile_OnTapped">
                                <Grid RowDefinitions="Auto,Auto,Auto">
                                    <!-- The action icon participates in the first title line. -->
                                    <Grid ColumnDefinitions="*,Auto" Grid.Row="0">
                                        <TextBlock Grid.Column="0"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap">
                                            <TextBlock.Inlines>
                                                <documents:InlineUIContainer BaselineAlignment="Center">
                                                    <avalonia:Icon Value="{Binding IconName}"
                                                                   Width="15"
                                                                   Height="15"
                                                                   FontSize="15"
                                                                   Margin="0,0,8,0"
                                                                   Foreground="{Binding IconColor}"/>
                                                </documents:InlineUIContainer>
                                                <Run Text="{Binding Name}"/>
                                            </TextBlock.Inlines>
                                        </TextBlock>
                                        <avalonia:Icon Grid.Column="1"
                                                       Value="fas fa-star"
                                                       Width="13"
                                                       Height="13"
                                                       Margin="8,2,0,0"
                                                       VerticalAlignment="Top"
                                                       Foreground="#FFD166"
                                                       IsVisible="{Binding IsFavorite}"
                                                       ToolTip.Tip="Favorite action"/>
                                    </Grid>
                                    
                                    <!-- Description -->
                                    <TextBlock Grid.Row="1"
                                               Text="{Binding Config.Description}" 
                                               Foreground="#b0b0b0"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               Margin="0,6,0,0"
                                               MaxHeight="40"
                                               TextTrimming="CharacterEllipsis"
                                               IsVisible="{Binding Config.Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                    
                                    <!-- Categories stay secondary, but every category remains visible. -->
                                    <ItemsControl Grid.Row="2"
                                                  ItemsSource="{Binding Config.Categories}"
                                                  Margin="0,6,0,0"
                                                  IsVisible="{Binding HasCategories}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding Converter={StaticResource CategoryToColorConverter}}"
                                                        Height="19"
                                                        CornerRadius="3"
                                                        Padding="6,0,6,2"
                                                        Margin="0,0,4,4"
                                                        Opacity="0.78"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding}"
                                                               FontSize="9"
                                                               FontWeight="SemiBold"
                                                               Foreground="White"
                                                               VerticalAlignment="Center"
                                                               LineHeight="12"/>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <views:ExecutionLogList Name="ExecutionLogListControl"
                                    Items="{Binding ExecutionLog}"
                                    SelectedItem="{Binding SelectedRecentExecution, Mode=TwoWay}"
                                    ShowDatePicker="True"
                                    IsVisible="{Binding IsRecentFilterSelected}"/>
        </Panel>
        
        <!-- Footer -->
        <Border Grid.Row="3" Background="#252526" BorderBrush="#3f3f46" BorderThickness="0,1,0,0" Padding="12,6">
            <Grid ColumnDefinitions="160,200">
                <!-- Base Action Counter -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <avalonia:Icon Value="fa-scroll" FontSize="12" Foreground="#3baced" Opacity="0.9"/>
                    <TextBlock Text="{Binding BaseActionCountText}" 
                               Foreground="#cccccc" 
                               FontSize="12" 
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Parameter Set Counter -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <avalonia:Icon Value="fa-list-ul" FontSize="12" Foreground="#3baced" Opacity="0.9"/>
                    <TextBlock Text="{Binding ParameterSetCountText}" 
                               Foreground="#cccccc" 
                               FontSize="12" 
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>

