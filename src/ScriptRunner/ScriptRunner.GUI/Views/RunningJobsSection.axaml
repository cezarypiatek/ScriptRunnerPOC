<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:ScriptRunner.GUI.ViewModels"
             xmlns:gui="clr-namespace:ScriptRunner.GUI"
             xmlns:avalonia="https://github.com/projektanker/icons.avalonia"
             xmlns:scriptConfigs="clr-namespace:ScriptRunner.GUI.ScriptConfigs"
             xmlns:controls="clr-namespace:ScriptRunner.GUI.Controls"
             xmlns:converters="clr-namespace:ScriptRunner.GUI.Converters"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="ScriptRunner.GUI.Views.RunningJobsSection"
             x:DataType="viewModels:MainWindowViewModel"
             >
    <UserControl.Resources>
      <converters:CountToVisibilityConverter x:Key="CountToVisibilityConverter" />
    </UserControl.Resources>
    <TabControl x:Name="RunningJobsPanel"
                ItemsSource="{Binding RunningJobs}"
                SelectedItem="{Binding SelectedRunningJob, Mode=TwoWay}">
      <TabControl.Styles>
        <Style Selector="TabItem">
          <Setter Property="MinHeight" Value="28" />
          <Setter Property="Margin" Value="0,0,2,0" />
          <Setter Property="Padding" Value="12,4,8,6" />
          <Setter Property="Foreground" Value="#A7A7AD" />
          <Setter Property="Background" Value="#252526" />
          <Setter Property="BorderBrush" Value="#3A3A3D" />
          <Setter Property="BorderThickness" Value="1,1,1,0" />
          <Setter Property="CornerRadius" Value="3,3,0,0" />
          <Setter Property="Template">
            <ControlTemplate>
              <Grid RowDefinitions="*,2">
                <Border x:Name="TabHeaderBackground"
                        Grid.RowSpan="2"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                  <ContentPresenter Content="{TemplateBinding Header}"
                                    ContentTemplate="{TemplateBinding HeaderTemplate}"
                                    VerticalAlignment="Center" />
                </Border>
                <Border x:Name="ActiveTabIndicator"
                        Grid.Row="1"
                        Height="2"
                        Margin="1,0"
                        Background="#4A9EFF"
                        IsVisible="False" />
              </Grid>
            </ControlTemplate>
          </Setter>
        </Style>
        <Style Selector="TabItem:pointerover /template/ Border#TabHeaderBackground">
          <Setter Property="Background" Value="#303033" />
          <Setter Property="BorderBrush" Value="#505055" />
        </Style>
        <Style Selector="TabItem:selected">
          <Setter Property="Foreground" Value="#F2F2F2" />
          <Setter Property="Background" Value="#1E1E1E" />
          <Setter Property="BorderBrush" Value="#55555B" />
        </Style>
        <Style Selector="TabItem:selected /template/ Border#ActiveTabIndicator">
          <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="Button.runningJobTabClose">
          <Setter Property="Width" Value="18" />
          <Setter Property="Height" Value="18" />
          <Setter Property="Margin" Value="4,0,0,0" />
          <Setter Property="Padding" Value="0" />
          <Setter Property="Background" Value="Transparent" />
          <Setter Property="Foreground" Value="#929298" />
          <Setter Property="FontSize" Value="8" />
          <Setter Property="HorizontalContentAlignment" Value="Center" />
          <Setter Property="VerticalContentAlignment" Value="Center" />
          <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.runningJobTabClose:pointerover">
          <Setter Property="Background" Value="#45454A" />
          <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Border.runningJobPulse">
          <Setter Property="Width" Value="7" />
          <Setter Property="Height" Value="7" />
          <Setter Property="Background" Value="#6EDB8F" />
          <Setter Property="CornerRadius" Value="4" />
          <Setter Property="Opacity" Value="0.9" />
          <Style.Animations>
            <Animation Duration="0:0:1.8"
                       IterationCount="INFINITE"
                       Easing="SineEaseInOut">
              <KeyFrame Cue="0%">
                <Setter Property="Opacity" Value="0.45" />
              </KeyFrame>
              <KeyFrame Cue="50%">
                <Setter Property="Opacity" Value="1" />
              </KeyFrame>
              <KeyFrame Cue="100%">
                <Setter Property="Opacity" Value="0.45" />
              </KeyFrame>
            </Animation>
          </Style.Animations>
        </Style>
        <Style Selector="Border.interactiveInputBadge">
          <Setter Property="Height" Value="18" />
          <Setter Property="MinWidth" Value="18" />
          <Setter Property="Margin" Value="7,0,1,0" />
          <Setter Property="Padding" Value="5,0" />
          <Setter Property="Background" Value="#3D321E" />
          <Setter Property="BorderBrush" Value="#B88A36" />
          <Setter Property="BorderThickness" Value="1" />
          <Setter Property="CornerRadius" Value="9" />
        </Style>
      </TabControl.Styles>
      <TabControl.ItemTemplate>
        <DataTemplate x:DataType="viewModels:RunningJobViewModel">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <StackPanel.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="Close All Finished" Command="{Binding $parent[TabControl].DataContext.CloseAllFinished}" />
                  <MenuItem Header="Close All Failed" Command="{Binding $parent[TabControl].DataContext.CloseAllFailed}" />
                  <MenuItem Header="Close All Cancelled" Command="{Binding $parent[TabControl].DataContext.CloseAllCancelled}" />
                </ContextMenu>
              </StackPanel.ContextMenu>
              <Border Classes="runningJobPulse"
                      Margin="0,0,7,0"
                      VerticalAlignment="Center"
                      IsVisible="{Binding IsRunning}"
                      ToolTip.Tip="Job is running" />
              <TextBlock FontSize="13"
                         VerticalAlignment="Center"
                         Text="{Binding Tile}"
                         Foreground="{Binding Status, Converter={x:Static gui:JobStatusToColorConverter.Instance}}"
                         ToolTip.Tip="{Binding Status, StringFormat='({0})'}" />
              <Border Classes="interactiveInputBadge"
                      VerticalAlignment="Center"
                      IsVisible="{Binding HasPendingInteractiveInput}"
                      ToolTip.Tip="User input required">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <avalonia:Icon Value="fas fa-exclamation"
                                 Width="7"
                                 Height="7"
                                 Foreground="#F2BE5C"
                                 VerticalAlignment="Center" />
                  <TextBlock Text="Input"
                             FontSize="10"
                             FontWeight="SemiBold"
                             Foreground="#F2C66D"
                             VerticalAlignment="Center" />
                </StackPanel>
              </Border>
              <Button Classes="runningJobTabClose"
                      avalonia:Attached.Icon="fas fa-times"
                      ToolTip.Tip="Close tab"
                      CommandParameter="{Binding}"
                      Command="{Binding $parent[TabControl].DataContext.CloseJob}" />
          </StackPanel>
        </DataTemplate>
      </TabControl.ItemTemplate>
      <TabControl.ContentTemplate>
        <DataTemplate DataType="viewModels:RunningJobViewModel">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"></RowDefinition>
              <RowDefinition Height="*"></RowDefinition>
              <RowDefinition Height="Auto"></RowDefinition>
              <RowDefinition Height="Auto"></RowDefinition>
            </Grid.RowDefinitions>
            
              <Border BorderBrush="#3E3E36" BorderThickness="1">
                  <SelectableTextBlock Margin="0" TextWrapping="Wrap" Classes="consoleOutput" Inlines="{Binding ExecutedCommandFormatted}" FontFamily="Cascadia Code, Consolas, Monospace" FontSize="13"/>    
              </Border>
              <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" MinWidth="200" />
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="{Binding NotificationRailWidth, Mode=TwoWay}" MaxWidth="600" />
                </Grid.ColumnDefinitions>
                <controls:FormattedTextEditor ScrollChanged="ScrollChangedHandler"
                                              Grid.Column="0"
                                              Margin="0,0,0,10"
                                              Classes="consoleOutput"
                                              ViewModel="{Binding}" />

                <GridSplitter Grid.Column="1"
                              Width="5"
                              Margin="5,0,0,10"
                              Background="#3C3C42"
                              ResizeDirection="Columns"
                              ResizeBehavior="PreviousAndNext"
                              Cursor="SizeWestEast"
                              IsVisible="{Binding Alerts.Count, Converter={StaticResource CountToVisibilityConverter}}" />

                <Border Grid.Column="2"
                        MinWidth="240"
                        MaxWidth="600"
                        Margin="5,0,0,10"
                        Background="#1C1C20"
                        BorderBrush="#3C3C42"
                        BorderThickness="1"
                        CornerRadius="8"
                        ClipToBounds="True"
                        IsVisible="{Binding Alerts.Count, Converter={StaticResource CountToVisibilityConverter}}">
                  <Grid RowDefinitions="Auto,*">
                    <Border Grid.Row="0"
                            Padding="14,11"
                            Background="#25252A"
                            BorderBrush="#3C3C42"
                            BorderThickness="0,0,0,1">
                      <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                          <TextBlock Text="Detected notifications"
                                     FontSize="13"
                                     FontWeight="SemiBold"
                                     Foreground="#F0F0F2"
                                     VerticalAlignment="Center" />
                        </StackPanel>
                        <Border Grid.Column="1"
                                MinWidth="24"
                                Height="22"
                                Padding="7,0"
                                Background="#303036"
                                CornerRadius="11">
                          <TextBlock Text="{Binding Alerts.Count}"
                                     FontSize="11"
                                     FontWeight="SemiBold"
                                     Foreground="#C8C8CD"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center" />
                        </Border>
                      </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                      <ItemsControl ItemsSource="{Binding Alerts}" Margin="10">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="viewModels:TroubleshootingAlertViewModel">
                            <Border Margin="0,0,0,8"
                                    Padding="0"
                                    Background="#242429"
                                    BorderBrush="#3D3D44"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    ClipToBounds="True">
                              <Grid ColumnDefinitions="4,*">
                                <Border Grid.Column="0"
                                        Background="{Binding Severity, Converter={x:Static viewModels:TroubleShootingSeverityToBrushConverter.Instance}}" />
                                <Grid Grid.Column="1"
                                      RowDefinitions="Auto,Auto"
                                      ColumnDefinitions="*,Auto"
                                      Margin="11,9,7,11">
                                  <TextBlock Grid.Row="0"
                                             Grid.Column="0"
                                             Text="{Binding Severity}"
                                             FontSize="11"
                                             FontWeight="SemiBold"
                                             Foreground="#BEBEC4"
                                             VerticalAlignment="Center" />
                                  <Button Grid.Row="0"
                                          Grid.Column="1"
                                          Width="24"
                                          Height="24"
                                          Margin="4,-4,-2,0"
                                          Padding="0"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Foreground="#96969D"
                                          Cursor="Hand"
                                          ToolTip.Tip="Dismiss notification"
                                          Command="{Binding DismissCommand}">
                                    <avalonia:Icon Value="fas fa-times" Width="9" Height="9" />
                                  </Button>
                                  <StackPanel Grid.Row="1"
                                              Grid.Column="0"
                                              Grid.ColumnSpan="2"
                                              Margin="0,7,4,0"
                                              Spacing="7">
                                    <SelectableTextBlock Text="{Binding AlertMessage}"
                                                         TextWrapping="Wrap"
                                                         FontSize="13"
                                                         LineHeight="18"
                                                         Foreground="#E5E5E8" />
                                    <TextBlock Text="{Binding TimestampText}"
                                               FontSize="11"
                                               Foreground="#85858D" />
                                  </StackPanel>
                                </Grid>
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>
                  </Grid>
                </Border>
              </Grid>
              <StackPanel Grid.Row="2" IsVisible="{Binding ExecutionPending, Mode=OneWay}" Margin="0, 0, 0,10">
                  <Panel IsVisible="{Binding CurrentInteractiveInputs.Count}" Margin="0,0,0,10">
                      <ItemsRepeater ItemsSource="{Binding CurrentInteractiveInputs}">
                          <ItemsRepeater.Layout>
                              <StackLayout Spacing="10"
                                           Orientation="Horizontal" />
                          </ItemsRepeater.Layout>
                          <ItemsRepeater.ItemTemplate>
                              <DataTemplate x:DataType="scriptConfigs:InteractiveInputItem">
                                  <Button Classes="interactiveAnswer" Content="{Binding Label}" Command="{Binding $parent[ItemsRepeater].DataContext.ExecuteInteractiveInput}" CommandParameter="{Binding Value}"></Button>
                              </DataTemplate>
                          </ItemsRepeater.ItemTemplate>
                      
                      </ItemsRepeater>
                  </Panel>
                  <TextBox  Text="{Binding InputCommand, Mode=TwoWay}" KeyUp="AcceptCommand"  Margin="0,0,10,0" FontFamily="Consolas"></TextBox>
              </StackPanel>
            
            <Grid Grid.Row="3" ColumnDefinitions="Auto,*" Margin="0,0,0,10">
              <Button Grid.Column="0"
                      Margin="0,0,10,0"
                      Padding="12,5"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Center"
                      IsVisible="{Binding CanOpenActionAgain}"
                      CommandParameter="{Binding}"
                      Command="{Binding $parent[TabControl].DataContext.OpenRunningJobAction}"
                      ToolTip.Tip="Open this action with the inputs used for this run">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <avalonia:Icon Value="fas fa-redo" Width="11" Height="11" />
                  <TextBlock Text="Open action again" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <StackPanel Grid.Column="1" Orientation="Horizontal" IsVisible="{Binding ExecutionPending}">
                <ProgressBar Classes="executionProgressBar" IsIndeterminate="{Binding ExecutionPending}" />
                <Button Width="60" HorizontalContentAlignment="Center" Margin="10,0" Command="{Binding CancelExecution}" IsEnabled="{Binding !KillAvailable}">Cancel</Button>
                <Button Width="60" HorizontalContentAlignment="Center" Command="{Binding Kill}" IsVisible="{Binding KillAvailable}" Background="Firebrick">Kill</Button>
              </StackPanel>
            </Grid>
          </Grid>

        </DataTemplate>
      </TabControl.ContentTemplate>

    </TabControl>
</UserControl>
